<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Windows SDK 22621 for Windows.Graphics.Capture with the border switched off
         (WindowCapture); the program still runs from Windows 10 build 19041 on, the newer
         APIs are guarded by OS version checks. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The program's version, the same for every project; shown in the title bar and in the
         notification area (AppInfo.Version). -->
    <Version>1.3.1</Version>
    <!-- Fixed inputs for a build anyone can follow (OFFEN Z6): every project keeps a
         packages.lock.json with the package versions and their hashes, and the release
         workflow restores in locked mode, so that no package can change under a commit. The SDK
         version is fixed by global.json beside this file. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The lock files hold the win-x64 graph too: the self-contained publish (-r win-x64)
         restores in locked mode as well. A plain build stays framework-dependent. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
